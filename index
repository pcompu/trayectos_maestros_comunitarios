                <!-- Generated Summary Area -->
                <div class="bg-black/60 p-4 rounded-xl border border-pixel-green/40 max-w-2xl mx-auto mb-6 text-left space-y-2">
                    <div class="flex justify-between items-center border-b border-gray-800 pb-2">
