<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desbloquea el Próximo Nivel: Trayecto 10 Años</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Press Start 2P & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pixel: {
                            bg: '#0b091a',
                            card: '#16132b',
                            border: '#332b5e',
                            accent: '#ff0055',
                            yellow: '#ffcc00',
                            green: '#00ff88',
                            cyan: '#00d9ff',
                            purple: '#a855f7'
                        }
                    },
                    fontFamily: {
                        game: ['"Press Start 2P"', 'cursive'],
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0b091a;
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(168, 85, 247, 0.18) 0%, transparent 40%),
                radial-gradient(circle at 85% 85%, rgba(0, 217, 255, 0.15) 0%, transparent 40%);
        }
        
        .pixel-card {
            background-color: #16132b;
            border: 2px solid #332b5e;
            box-shadow: 0 8px 0 #070510;
        }

        .pixel-btn {
            position: relative;
            transition: all 0.15s ease;
            box-shadow: 0 5px 0 #070510;
        }

        .pixel-btn:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 2px 0 #070510;
        }

        .glow-effect {
            box-shadow: 0 0 20px rgba(0, 255, 136, 0.35);
        }

        .glow-gold {
            box-shadow: 0 0 25px rgba(255, 204, 0, 0.5);
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-6px); }
        }

        .floating {
            animation: float 3s ease-in-out infinite;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b091a;
        }
        ::-webkit-scrollbar-thumb {
            background: #332b5e;
            border-radius: 4px;
        }
    </style>
</head>
<body class="text-white font-sans min-h-screen flex flex-col justify-between selection:bg-pixel-accent selection:text-white">

    <!-- Background Canvas for Particles -->
    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0 opacity-40"></canvas>

    <!-- Header Navigation -->
    <header class="relative z-10 w-full max-w-5xl mx-auto px-4 pt-4 pb-2 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-pixel-purple/30 rounded-lg flex items-center justify-center text-pixel-yellow text-xl border border-pixel-purple shadow-md">
                <i class="fa-solid fa-gamepad"></i>
            </div>
            <div>
                <h1 class="font-game text-xs md:text-sm text-pixel-yellow tracking-wider uppercase">Trayecto 10 Años</h1>
                <p class="text-[11px] text-purple-300 font-semibold">Encuentro 6 — Maestros Comunitarios 2026</p>
            </div>
        </div>

        <div class="flex items-center space-x-2 md:space-x-4">
            <!-- Timer Indicator (90 min session) -->
            <div class="bg-pixel-card border border-purple-500/30 px-3 py-1.5 rounded-lg flex items-center space-x-2 text-xs text-gray-300">
                <i class="fa-regular fa-clock text-pixel-cyan"></i>
                <span class="hidden sm:inline">Tiempo Guía:</span>
                <span id="sessionTimer" class="font-mono text-pixel-cyan font-bold">90 min</span>
            </div>

            <!-- Audio Toggle Button -->
            <button id="soundToggleBtn" onclick="toggleSound()" class="px-2.5 py-1.5 bg-pixel-card hover:bg-pixel-border text-xs text-purple-200 rounded-lg border border-purple-500/30 flex items-center space-x-1.5 transition">
                <i id="soundIcon" class="fa-solid fa-volume-high text-pixel-green"></i>
                <span id="soundLabel" class="hidden sm:inline">Audio</span>
            </button>

            <!-- Level Badge Indicator -->
            <div class="bg-pixel-card border border-pixel-purple px-3 py-1.5 rounded-lg flex items-center space-x-2">
                <i class="fa-solid fa-trophy text-pixel-yellow text-xs"></i>
                <span id="headerLevel" class="font-game text-xs text-pixel-green">NIVEL 09</span>
            </div>
        </div>
    </header>

    <!-- Main Interactive Container -->
    <main class="relative z-10 w-full max-w-4xl mx-auto px-4 py-2 flex-grow flex flex-col justify-center">

        <!-- Progress Bar Card -->
        <div class="mb-5 bg-pixel-card/90 backdrop-blur-md p-3 md:p-4 rounded-xl border border-purple-500/30 shadow-xl">
            <div class="flex justify-between items-center mb-1.5">
                <div class="flex items-center space-x-2">
                    <span id="missionBadge" class="text-[10px] bg-pixel-purple/30 text-purple-200 px-2.5 py-0.5 rounded border border-purple-500/40 font-game">MISIÓN 0 / 4</span>
                    <span id="missionTitleText" class="text-xs font-bold text-gray-200 hidden sm:inline">Entrada al Juego</span>
                </div>
                <span id="xpText" class="font-game text-xs text-pixel-yellow">0 / 100 XP</span>
            </div>
            <div class="w-full bg-gray-950 h-3.5 rounded-full overflow-hidden p-0.5 border border-purple-900">
                <div id="xpBar" class="h-full bg-gradient-to-r from-purple-600 via-pixel-cyan to-pixel-green rounded-full transition-all duration-500 ease-out" style="width: 5%;"></div>
            </div>
        </div>

        <!-- SCREEN 0: MISIÓN 0 - ENTRADA AL JUEGO (5 min) -->
        <section id="screen-mision0" class="space-y-5">
            <div class="pixel-card p-6 md:p-8 rounded-2xl relative overflow-hidden text-center shadow-2xl">
                <div class="inline-block bg-pixel-yellow/10 border border-pixel-yellow text-pixel-yellow px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest mb-4 floating">
                    <i class="fa-solid fa-crown mr-1"></i> Hacia el Trayecto 2027 (10 Años)
                </div>

                <h2 class="font-game text-base md:text-xl text-white mb-3 leading-relaxed">
                    ¡Bienvenidos, Diseñadores del Próximo Nivel!
                </h2>

                <p class="text-purple-200 text-xs md:text-sm max-w-2xl mx-auto leading-relaxed mb-6">
                    "Hoy no venimos solamente a evaluar lo que hicimos. Vamos a imaginar qué debería pasar después. El Trayecto cumple 10 años en 2027 y ustedes asumirán el rol de diseñadores de su próximo nivel."
                </p>

                <div class="bg-black/40 p-4 rounded-xl border border-purple-500/30 mb-6 max-w-xl mx-auto text-left text-xs space-y-2">
                    <div class="flex items-center space-x-2 text-pixel-cyan font-bold">
                        <i class="fa-solid fa-compass"></i>
                        <span>Dinámica del Juego (90 Minutos):</span>
                    </div>
                    <p class="text-gray-300 leading-relaxed">
                        En cada misión: <strong class="text-pixel-yellow">CONVERSAN + DECIDEN + REGISTRAN</strong>. Trabajan primero en subgrupos de forma colaborativa y van ingresando aquí las decisiones para desbloquear el formulario final.
                    </p>
                </div>

                <!-- Select Subgroup Name -->
                <div class="mb-6 max-w-md mx-auto text-left">
                    <label class="block text-xs font-bold text-purple-300 uppercase mb-2">Nombre de tu Grupo / Colectivo:</label>
                    <input type="text" id="groupNameInput" placeholder="Ej: Equipo Comunitario Centro" class="w-full bg-black/50 border border-purple-500/50 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-pixel-cyan transition">
                </div>

                <button onclick="startMision1()" class="pixel-btn bg-pixel-green hover:bg-emerald-400 text-gray-950 font-extrabold px-8 py-3.5 rounded-xl font-game text-xs tracking-wider transition uppercase flex items-center justify-center mx-auto space-x-2 glow-effect">
                    <span>Iniciar Misión 1: El Inventario</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </section>

        <!-- SCREEN 1: MISIÓN 1 - EL INVENTARIO (15 min) -->
        <section id="screen-mision1" class="hidden space-y-5">
            <div class="pixel-card p-5 md:p-7 rounded-2xl relative shadow-2xl">
                <div class="flex justify-between items-center border-b border-purple-500/30 pb-3 mb-4">
                    <div>
                        <span class="bg-purple-900/60 text-pixel-cyan font-game text-[10px] px-2.5 py-1 rounded border border-purple-500/40">MISIÓN 1</span>
                        <h3 class="font-bold text-white text-base md:text-lg inline-block ml-2">El Inventario</h3>
                    </div>
                    <span class="text-xs text-pixel-yellow font-semibold"><i class="fa-solid fa-box-archive mr-1"></i> ¿Qué conservar? (Max 5/cat)</span>
                </div>

                <p class="text-xs text-gray-300 mb-4">
                    <em>"El sistema debe actualizarse, pero no queremos perder lo que funciona."</em> Selecciona hasta 5 elementos por categoría que deben seguir formando parte del Trayecto 2027:
                </p>

                <!-- Category Tabs / Grid -->
                <div class="space-y-5 mb-6">
                    <!-- Contenidos (Blue cards) -->
                    <div>
                        <h4 class="text-xs font-bold text-pixel-cyan uppercase mb-2 flex items-center">
                            <i class="fa-solid fa-book-bookmark mr-2"></i> Contenidos a Conservar
                        </h4>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs" id="contenidosGrid">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <!-- Tecnologías (Green cards) -->
                    <div>
                        <h4 class="text-xs font-bold text-pixel-green uppercase mb-2 flex items-center">
                            <i class="fa-solid fa-laptop-code mr-2"></i> Tecnologías a Conservar
                        </h4>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs" id="tecnologiasGrid">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <!-- Metodologías (Yellow cards) -->
                    <div>
                        <h4 class="text-xs font-bold text-pixel-yellow uppercase mb-2 flex items-center">
                            <i class="fa-solid fa-chalkboard-user mr-2"></i> Metodologías a Conservar
                        </h4>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs" id="metodologiasGrid">
                            <!-- Populated via JS -->
                        </div>
                    </div>
                </div>

                <!-- Experiencia Memorable -->
                <div class="bg-black/30 p-4 rounded-xl border border-purple-500/30 mb-6">
                    <label class="block text-xs font-bold text-pixel-yellow uppercase mb-1">
                        <i class="fa-solid fa-star mr-1"></i> Experiencia Memorable:
                    </label>
                    <p class="text-[11px] text-gray-400 mb-2">¿Qué experiencia del Trayecto te hizo sentir que realmente aprendiste algo que podías llevar a tu práctica?</p>
                    <textarea id="expMemorableInput" rows="2" placeholder="Describe brevemente la experiencia memorable del grupo..." class="w-full bg-black/50 border border-purple-500/40 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-yellow transition"></textarea>
                </div>

                <div class="flex justify-end">
                    <button onclick="submitMision1()" class="pixel-btn bg-pixel-cyan hover:bg-cyan-400 text-gray-950 font-extrabold px-6 py-3 rounded-xl font-game text-xs transition uppercase flex items-center space-x-2">
                        <span>Avanzar a Misión 2</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- SCREEN 2: MISIÓN 2 - HACKEÁ EL TRAYECTO (15 min) -->
        <section id="screen-mision2" class="hidden space-y-5">
            <div class="pixel-card p-5 md:p-7 rounded-2xl relative shadow-2xl">
                <div class="flex justify-between items-center border-b border-purple-500/30 pb-3 mb-4">
                    <div>
                        <span class="bg-rose-900/60 text-pixel-accent font-game text-[10px] px-2.5 py-1 rounded border border-rose-500/40">MISIÓN 2</span>
                        <h3 class="font-bold text-white text-base md:text-lg inline-block ml-2">Hackeá el Trayecto</h3>
                    </div>
                    <span class="text-xs text-pixel-accent font-semibold"><i class="fa-solid fa-bug mr-1"></i> Eliminar / Transformar</span>
                </div>

                <div class="bg-rose-950/30 border border-rose-500/30 p-3.5 rounded-xl mb-4 text-xs text-purple-200">
                    <p class="font-bold text-pixel-accent mb-1"><i class="fa-solid fa-terminal mr-1"></i> ¡Permiso para hackear activado!</p>
                    <p>Detecten aspectos que ya no funcionan. Recuerden la regla del mediador: convertir las críticas en propuestas alternativas ("Sacaría X porque... y pondría Y...").</p>
                </div>

                <div class="space-y-4 mb-6">
                    <!-- Item to ELIMINATE -->
                    <div class="bg-black/40 p-4 rounded-xl border border-rose-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-accent uppercase flex items-center">
                            <i class="fa-solid fa-trash-can mr-2"></i> Elemento a ELIMINAR (Esto ya no debería estar)
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <input type="text" id="eliminarQue" placeholder="¿Qué eliminarían?" class="bg-black/60 border border-gray-700 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-accent">
                            <input type="text" id="eliminarPorQue" placeholder="¿Por qué motivo?" class="bg-black/60 border border-gray-700 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-accent">
                        </div>
                    </div>

                    <!-- Item to TRANSFORM -->
                    <div class="bg-black/40 p-4 rounded-xl border border-purple-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-purple uppercase flex items-center">
                            <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Elemento a TRANSFORMAR (Tiene valor pero necesita otra forma)
                        </h4>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <input type="text" id="transformarQue" placeholder="¿Qué transformarían?" class="bg-black/60 border border-gray-700 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-purple">
                            <input type="text" id="transformarPorQue" placeholder="¿Por qué motivo?" class="bg-black/60 border border-gray-700 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-purple">
                            <input type="text" id="transformarAlternativa" placeholder="¿Qué alternativa pondrían?" class="bg-black/60 border border-gray-700 rounded-lg p-2.5 text-xs text-white focus:outline-none focus:border-pixel-purple">
                        </div>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="goToScreen('screen-mision1')" class="text-xs text-gray-400 hover:text-white transition">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Volver
                    </button>
                    <button onclick="submitMision2()" class="pixel-btn bg-pixel-cyan hover:bg-cyan-400 text-gray-950 font-extrabold px-6 py-3 rounded-xl font-game text-xs transition uppercase flex items-center space-x-2">
                        <span>Avanzar a Misión 3</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- SCREEN 3: MISIÓN 3 - DESBLOQUEÁ PORTALES (15 min) -->
        <section id="screen-mision3" class="hidden space-y-5">
            <div class="pixel-card p-5 md:p-7 rounded-2xl relative shadow-2xl">
                <div class="flex justify-between items-center border-b border-purple-500/30 pb-3 mb-4">
                    <div>
                        <span class="bg-amber-900/60 text-pixel-yellow font-game text-[10px] px-2.5 py-1 rounded border border-amber-500/40">MISIÓN 3</span>
                        <h3 class="font-bold text-white text-base md:text-lg inline-block ml-2">Desbloqueá Portales (Hasta 3 por portal)</h3>
                    </div>
                    <span class="text-xs text-pixel-yellow font-semibold"><i class="fa-solid fa-door-open mr-1"></i> Necesidades 2027</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <!-- PORTAL 1: Ciudadanía Digital -->
                    <div class="bg-black/30 p-4 rounded-xl border border-purple-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-cyan uppercase flex items-center">
                            <i class="fa-solid fa-shield-halved mr-2"></i> Portal 1: Ciudadanía Digital
                        </h4>
                        <p class="text-[11px] text-gray-400">¿Qué contenidos de CD son indispensables para 2027 y por qué?</p>
                        <textarea id="portal1Input" rows="2" placeholder="Ej: Privacidad, desinformación, IA y sesgos..." class="w-full bg-black/60 border border-gray-700 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-pixel-cyan"></textarea>
                    </div>

                    <!-- PORTAL 2: Tecnologías -->
                    <div class="bg-black/30 p-4 rounded-xl border border-purple-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-green uppercase flex items-center">
                            <i class="fa-solid fa-microchip mr-2"></i> Portal 2: Tecnologías (Uso Pedagógico)
                        </h4>
                        <p class="text-[11px] text-gray-400">¿Qué te gustaría poder hacer pedagógicamente con ellas?</p>
                        <textarea id="portal2Input" rows="2" placeholder="Ej: Con Micro:bit diseñar soluciones ambientales con alumnos..." class="w-full bg-black/60 border border-gray-700 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-pixel-green"></textarea>
                    </div>

                    <!-- PORTAL 3: Jugar para Aprender -->
                    <div class="bg-black/30 p-4 rounded-xl border border-purple-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-yellow uppercase flex items-center">
                            <i class="fa-solid fa-dice mr-2"></i> Portal 3: Jugar para Aprender
                        </h4>
                        <p class="text-[11px] text-gray-400">¿Qué debería aprender un docente para diseñar ABJ / Gamificación?</p>
                        <textarea id="portal3Input" rows="2" placeholder="Ej: Escape rooms pedagógicos, narrativas gamificadas..." class="w-full bg-black/60 border border-gray-700 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-pixel-yellow"></textarea>
                    </div>

                    <!-- PORTAL 4: Comunidad -->
                    <div class="bg-black/30 p-4 rounded-xl border border-purple-500/30 space-y-2">
                        <h4 class="text-xs font-bold text-pixel-purple uppercase flex items-center">
                            <i class="fa-solid fa-people-roof mr-2"></i> Portal 4: Comunidad & Familias
                        </h4>
                        <p class="text-[11px] text-gray-400">¿Cómo conectar tecnología, escuela, familias y comunidad?</p>
                        <textarea id="portal4Input" rows="2" placeholder="Ej: Talleres familiares interactivos, muestras digitales..." class="w-full bg-black/60 border border-gray-700 rounded-lg p-2 text-xs text-white focus:outline-none focus:border-pixel-purple"></textarea>
                    </div>
                </div>

                <div class="flex justify-between items-center">
                    <button onclick="goToScreen('screen-mision2')" class="text-xs text-gray-400 hover:text-white transition">
                        <i class="fa-solid fa-arrow-left mr-1"></i> Volver
                    </button>
                    <button onclick="submitMision3()" class="pixel-btn bg-pixel-cyan hover:bg-cyan-400 text-gray-950 font-extrabold px-6 py-3 rounded-xl font-game text-xs transition uppercase flex items-center space-x-2">
                        <span>Avanzar a Recarga</span>
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- SCREEN RECARGA: INTERMEDIO (10 min) -->
        <section id="screen-recarga" class="hidden space-y-5">
            <div class="pixel-card p-6 md:p-8 rounded-2xl relative text-center shadow-2xl">
                <div class="inline-block bg-pixel-green/10 border border-pixel-green text-pixel-green px-4 py-1.5 rounded-full text-xs font-bold font-game uppercase tracking-widest mb-4 floating">
                    <i class="fa-solid fa-bolt mr-1"></i> RECARGANDO PUNTOS DE ENERGÍA...
                </div>

                <h2 class="font-game text-sm md:text-lg text-white mb-3">
                    Consolidando Descubrimientos
                </h2>

                <p class="text-xs md:text-sm text-purple-200 max-w-xl mx-auto mb-6">
                    <em>"Ya desbloquearon muchas ideas. Ahora viene el desafío más importante: diseñar el próximo nivel."</em>
                </p>

                <!-- Consolidación Visual -->
                <div class="bg-black/50 p-4 rounded-xl border border-purple-500/30 max-w-2xl mx-auto text-left space-y-3 mb-6 text-xs">
                    <h4 class="font-bold text-pixel-yellow uppercase border-b border-gray-800 pb-2">Resumen de Insumos Activos:</h4>
                    <div id="recargaSummary" class="space-y-1.5 text-gray-300">
                        <!-- Populated by JS -->
                    </div>
                </div>

                <button onclick="goToMision4()" class="pixel-btn bg-pixel-green hover:bg-emerald-400 text-gray-950 font-extrabold px-8 py-3.5 rounded-xl font-game text-xs tracking-wider transition uppercase flex items-center justify-center mx-auto space-x-2 glow-effect">
                    <span>Diseñá el Módulo TF 2027 (Misión 4)</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </section>

        <!-- SCREEN 4: MISIÓN 4 - DISEÑÁ EL PRÓXIMO NIVEL TF 2027 (20 min) -->
        <section id="screen-mision4" class="hidden space-y-5">
            <div class="pixel-card p-5 md:p-7 rounded-2xl relative shadow-2xl">
                <div class="flex justify-between items-center border-b border-purple-500/30 pb-3 mb-4">
                    <div>
                        <span class="bg-emerald-900/60 text-pixel-green font-game text-[10px] px-2.5 py-1 rounded border border-emerald-500/40">MISIÓN 4</span>
                        <h3 class="font-bold text-white text-base md:text-lg inline-block ml-2">Diseñá un Módulo del Trayecto 2027</h3>
                    </div>
                    <span class="text-xs text-pixel-green font-semibold"><i class="fa-solid fa-pen-ruler mr-1"></i> Co-Diseño Curricular</span>
                </div>

                <!-- Form Tablero del Módulo -->
                <div class="space-y-4 mb-6">
                    <div>
                        <label class="block text-xs font-bold text-pixel-yellow uppercase mb-1">1. Nombre del Módulo:</label>
                        <input type="text" id="modNombre" placeholder="Ej: Laboratorio Gamificado de Ciudadanía y Micro:bit" class="w-full bg-black/60 border border-purple-500/40 rounded-xl p-2.5 text-xs text-white focus:outline-none focus:border-pixel-yellow">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-pixel-cyan uppercase mb-1">2. Foco Central (Carta en el centro):</label>
