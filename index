                       target="_blank" 
                       rel="noopener noreferrer" 
                       class="pixel-btn block w-full text-center bg-gradient-to-r from-pixel-green to-emerald-400 hover:from-emerald-400 hover:to-pixel-green text-gray-950 font-extrabold py-3.5 px-6 rounded-xl font-game text-xs md:text-sm uppercase tracking-wider transition shadow-lg glow-effect">
