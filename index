        <span id="toastMessage">¡Guardado!</span>
    </div>

    <!-- Footer -->
    <footer class="relative z-10 w-full max-w-5xl mx-auto px-4 py-4 text-center text-[11px] text-purple-300/50 border-t border-purple-900/30 mt-4">
        <p>Trayecto de Formación para Maestros Comunitarios 2026 — 10 Años de Impacto (2027)</p>
    </footer>

    <script>
        // Game State Variables
        const gameState = {
            groupName: '',
            level: 9,
            xp: 0,
            soundEnabled: true,
            mision1: {
                contenidos: [],
                tecnologias: [],
                metodologias: [],
                expMemorable: ''
            },
            mision2: {
                eliminarQue: '',
                eliminarPorQue: '',
                transformarQue: '',
                transformarPorQue: '',
                transformarAlternativa: ''
            },
            mision3: {
                portal1: '',
                portal2: '',
                portal3: '',
                portal4: ''
            },
            mision4: {
                nombre: '',
                foco: '',
                aliados: '',
                acciones: '',
                entregable: '',
                contexto: ''
            }
        };

        // Data arrays for Mission 1 cards based on Encuentro 6 document
        const M1_DATA = {
            contenidos: [
                "Huella digital", "Datos personales", "Análisis de la información",
                "Participación digital", "Pensamiento computacional", "IA y sesgos algorítmicos"
            ],
            tecnologias: [
                "PC / Laptops", "Micro:bit", "Minecraft Education",
                "Scratch", "Audiovisual", "Herramientas de IA"
            ],
            metodologias: [
                "Metodologías activas (Gamificación)", "Videojuegos / ABJ", "Talleres + acompañamiento",
                "Intercambio entre pares", "Prototipado digital", "Actividades en el medio"
            ]
        };

        // Web Audio Synthesizer
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playSound(type) {
            if (!gameState.soundEnabled) return;
            try {
                initAudio();
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'click') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(350, now);
                    osc.frequency.exponentialRampToValueAtTime(700, now + 0.04);
                    gain.gain.setValueAtTime(0.08, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.04);
                    osc.start(now);
                    osc.stop(now + 0.04);
                } else if (type === 'select') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.06);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.15);
                    osc.start(now);
                    osc.stop(now + 0.15);
                } else if (type === 'fanfare') {
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, idx) => {
                        const noteOsc = audioCtx.createOscillator();
                        const noteGain = audioCtx.createGain();
                        noteOsc.type = 'sine';
                        noteOsc.frequency.setValueAtTime(freq, now + idx * 0.1);
                        noteGain.gain.setValueAtTime(0.15, now + idx * 0.1);
                        noteGain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.1 + 0.25);
                        noteOsc.connect(noteGain);
                        noteGain.connect(audioCtx.destination);
                        noteOsc.start(now + idx * 0.1);
                        noteOsc.stop(now + idx * 0.1 + 0.25);
                    });
                }
            } catch (e) {
                console.log("Audio error:", e);
            }
        }

        function toggleSound() {
            gameState.soundEnabled = !gameState.soundEnabled;
            const soundIcon = document.getElementById('soundIcon');
            const soundLabel = document.getElementById('soundLabel');
            
            if (gameState.soundEnabled) {
                soundIcon.className = "fa-solid fa-volume-high text-pixel-green";
                soundLabel.innerText = "Audio";
                playSound('select');
            } else {
                soundIcon.className = "fa-solid fa-volume-xmark text-gray-500";
                soundLabel.innerText = "Mute";
            }
        }

        // Render Mission 1 Selectable Cards
        function renderMision1Cards() {
            const populate = (items, containerId, categoryKey, activeColorClass) => {
                const container = document.getElementById(containerId);
                container.innerHTML = '';
                items.forEach(item => {
                    const isSelected = gameState.mision1[categoryKey].includes(item);
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = `p-2.5 rounded-lg border text-left transition flex items-center justify-between ${
                        isSelected 
                        ? `${activeColorClass} bg-purple-900/50 font-bold shadow` 
                        : 'border-purple-500/20 bg-black/30 hover:border-purple-500/50 text-gray-300'
                    }`;
                    btn.innerHTML = `
                        <span>${item}</span>
                        <i class="fa-solid ${isSelected ? 'fa-check-circle' : 'fa-circle-plus'} text-xs"></i>
                    `;
                    btn.onclick = () => toggleM1Item(categoryKey, item);
                    container.appendChild(btn);
                });
            };

            populate(M1_DATA.contenidos, 'contenidosGrid', 'contenidos', 'border-pixel-cyan text-pixel-cyan');
            populate(M1_DATA.tecnologias, 'tecnologiasGrid', 'tecnologias', 'border-pixel-green text-pixel-green');
            populate(M1_DATA.metodologias, 'metodologiasGrid', 'metodologias', 'border-pixel-yellow text-pixel-yellow');
        }

        function toggleM1Item(catKey, item) {
            playSound('select');
            const list = gameState.mision1[catKey];
            const index = list.indexOf(item);
            if (index > -1) {
                list.splice(index, 1);
            } else {
                if (list.length >= 5) {
                    showToast("Máximo 5 elementos por categoría");
                    return;
                }
                list.push(item);
            }
            renderMision1Cards();
        }

        // Navigation & Screen Control
        function goToScreen(screenId) {
            playSound('click');
            const screens = ['screen-mision0', 'screen-mision1', 'screen-mision2', 'screen-mision3', 'screen-recarga', 'screen-mision4', 'screen-unlocked'];
            screens.forEach(s => document.getElementById(s).classList.add('hidden'));
            document.getElementById(screenId).classList.remove('hidden');
        }

        function updateXP(amount, misionText, badgeText) {
            gameState.xp = amount;
            document.getElementById('xpBar').style.width = `${amount}%`;
            document.getElementById('xpText').innerText = `${amount} / 100 XP`;
            document.getElementById('missionBadge').innerText = badgeText;
            document.getElementById('missionTitleText').innerText = misionText;
        }

        // Start Mission 1
        function startMision1() {
            const groupInput = document.getElementById('groupNameInput').value.trim();
            gameState.groupName = groupInput || "Equipo Maestro Comunitario";
            updateXP(20, "El Inventario", "MISIÓN 1 / 4");
            renderMision1Cards();
            goToScreen('screen-mision1');
        }

        // Submit Mission 1
        function submitMision1() {
            gameState.mision1.expMemorable = document.getElementById('expMemorableInput').value.trim();
            updateXP(40, "Hackeá el Trayecto", "MISIÓN 2 / 4");
            goToScreen('screen-mision2');
        }

        // Submit Mission 2
        function submitMision2() {
            gameState.mision2.eliminarQue = document.getElementById('eliminarQue').value.trim();
            gameState.mision2.eliminarPorQue = document.getElementById('eliminarPorQue').value.trim();
            gameState.mision2.transformarQue = document.getElementById('transformarQue').value.trim();
            gameState.mision2.transformarPorQue = document.getElementById('transformarPorQue').value.trim();
            gameState.mision2.transformarAlternativa = document.getElementById('transformarAlternativa').value.trim();

            updateXP(60, "Desbloqueá Portales", "MISIÓN 3 / 4");
            goToScreen('screen-mision3');
        }

        // Submit Mission 3
        function submitMision3() {
            gameState.mision3.portal1 = document.getElementById('portal1Input').value.trim();
            gameState.mision3.portal2 = document.getElementById('portal2Input').value.trim();
            gameState.mision3.portal3 = document.getElementById('portal3Input').value.trim();
            gameState.mision3.portal4 = document.getElementById('portal4Input').value.trim();

            // Populate Recarga Summary
            const summaryDiv = document.getElementById('recargaSummary');
            summaryDiv.innerHTML = `
                <p><strong>• Contenidos a conservar:</strong> ${gameState.mision1.contenidos.join(', ') || 'Ninguno seleccionado'}</p>
                <p><strong>• Tecnologías a conservar:</strong> ${gameState.mision1.tecnologias.join(', ') || 'Ninguna seleccionada'}</p>
                <p><strong>• Metodologías a conservar:</strong> ${gameState.mision1.metodologias.join(', ') || 'Ninguna seleccionada'}</p>
                <p><strong>• Transformación propuesta:</strong> ${gameState.mision2.transformarQue ? `${gameState.mision2.transformarQue} ➔ ${gameState.mision2.transformarAlternativa}` : 'Sin cambios registradas'}</p>
            `;

            updateXP(75, "Recarga de Energía", "INTERMEDIO");
            goToScreen('screen-recarga');
        }

        // Go to Mission 4
        function goToMision4() {
            updateXP(85, "Diseñá el Módulo 2027", "MISIÓN 4 / 4");
            goToScreen('screen-mision4');
        }

        // Submit Mission 4 & Final Unlock
        function submitMision4() {
            gameState.mision4.nombre = document.getElementById('modNombre').value.trim();
            gameState.mision4.foco = document.getElementById('modFoco').value.trim();
            gameState.mision4.aliados = document.getElementById('modAliados').value.trim();
            gameState.mision4.acciones = document.getElementById('modAcciones').value.trim();
            gameState.mision4.entregable = document.getElementById('modEntregable').value.trim();
            gameState.mision4.contexto = document.getElementById('modContexto').value;

            // Generate Final Summary Text for Google Form Clipboard
            const summaryText = 
`[EQUIPO/GRUPO]: ${gameState.groupName}

[MISIÓN 1 - CONSERVAR]:
- Contenidos: ${gameState.mision1.contenidos.join(', ') || 'N/A'}
- Tecnologías: ${gameState.mision1.tecnologias.join(', ') || 'N/A'}
- Metodologías: ${gameState.mision1.metodologias.join(', ') || 'N/A'}
- Exp. Memorable: ${gameState.mision1.expMemorable || 'N/A'}

[MISIÓN 2 - HACKEAR]:
- Eliminar: ${gameState.mision2.eliminarQue} (Motivo: ${gameState.mision2.eliminarPorQue})
- Transformar: ${gameState.mision2.transformarQue} ➔ Alternativa: ${gameState.mision2.transformarAlternativa}

[MISIÓN 3 - PORTALES]:
- Ciudadanía Digital: ${gameState.mision3.portal1 || 'N/A'}
- Tecnologías (Uso): ${gameState.mision3.portal2 || 'N/A'}
- Jugar para Aprender: ${gameState.mision3.portal3 || 'N/A'}
- Comunidad: ${gameState.mision3.portal4 || 'N/A'}

[MISIÓN 4 - MÓDULO 2027]:
- Nombre del Módulo: ${gameState.mision4.nombre || 'Módulo Co-diseñado'}
- Foco Central: ${gameState.mision4.foco || 'N/A'}
- Aliados: ${gameState.mision4.aliados || 'N/A'}
- Acciones Docente: ${gameState.mision4.acciones || 'N/A'}
- Se lleva (Entregable): ${gameState.mision4.entregable || 'N/A'}
- Contexto de Aplicación: ${gameState.mision4.contexto}`;

            document.getElementById('finalSummaryText').value = summaryText;

            // Unlock Level 10
            gameState.level = 10;
            updateXP(100, "¡NIVEL 10 DESBLOQUEADO!", "NIVEL MÁXIMO");
            document.getElementById('headerLevel').innerText = "NIVEL 10";
            document.getElementById('headerLevel').className = "font-game text-xs text-pixel-yellow font-extrabold";

            playSound('fanfare');
            goToScreen('screen-unlocked');

            // Trigger Confetti
            if (typeof confetti === 'function') {
                confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
            }
        }

        // Copy Summary to Clipboard
        function copySummary() {
            playSound('click');
            const summaryArea = document.getElementById('finalSummaryText');
            summaryArea.select();
            document.execCommand('copy');

            const btnText = document.getElementById('copyBtnText');
            btnText.innerText = "¡Copiado!";
            setTimeout(() => { btnText.innerText = "Copiar Resumen"; }, 3000);

            showToast("Resumen copiado al portapapeles");
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function restartGame() {
            playSound('click');
            gameState.level = 9;
            gameState.mision1.contenidos = [];
            gameState.mision1.tecnologias = [];
            gameState.mision1.metodologias = [];
            document.getElementById('headerLevel').innerText = "NIVEL 09";
            document.getElementById('headerLevel').className = "font-game text-xs text-pixel-green";
            updateXP(0, "Entrada al Juego", "MISIÓN 0 / 4");
            goToScreen('screen-mision0');
        }

        // Canvas Particles BG Animation
        window.onload = function() {
            const canvas = document.getElementById('bgCanvas');
            const ctx = canvas.getContext('2d');

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            const particles = Array.from({ length: 35 }, () => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                size: Math.random() * 2.5 + 1,
                speedY: Math.random() * 0.4 + 0.1,
                opacity: Math.random() * 0.7 + 0.3,
                color: Math.random() > 0.5 ? '#00d9ff' : '#a855f7'
            }));

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                particles.forEach(p => {
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = p.opacity;
                    ctx.fillRect(p.x, p.y, p.size, p.size);
                    p.y -= p.speedY;
                    if (p.y < 0) {
                        p.y = canvas.height;
                        p.x = Math.random() * canvas.width;
                    }
                });
                requestAnimationFrame(animate);
            }
            animate();
        };
    </script>
