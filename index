    <!-- Toast Message Container -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none bg-pixel-card border border-pixel-green text-pixel-green px-4 py-2.5 rounded-xl shadow-2xl flex items-center space-x-2 text-xs font-bold">
