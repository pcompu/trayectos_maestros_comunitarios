                    <button onclick="submitMision4()" class="pixel-btn bg-gradient-to-r from-pixel-yellow to-pixel-green hover:brightness-110 text-gray-950 font-extrabold px-7 py-3 rounded-xl font-game text-xs transition uppercase flex items-center space-x-2 glow-gold">
                        <span>Finalizar Misiones & Priorizar</span>
